@@ -0,0 +1,22 @@
+import { useState } from 'react';
+import { useWebsocketAPI } from './websocket-api';
+import { RpcMessage, SetForceStandingPoseRequestT } from 'solarxr-protocol';
+
+export function useForceStandingPose() {
+  const { sendRPCPacket } = useWebsocketAPI();
+  const [forced, setForced] = useState(false);
+
+  const toggle = () => {
+    const newForced = !forced;
+    setForced(newForced);
+    sendRPCPacket(
+      RpcMessage.SetForceStandingPoseRequest,
+      new SetForceStandingPoseRequestT(newForced)
+    );
+  };
+
+  return {
+    toggle,
+    forced,
+  };
+}
